# ── ABA PayWay ──────────────────────────────────────────────
# Set PAYWAY_MODE=live only when you have valid merchant credentials.
# The API key / RSA keys below are PLACEHOLDERS — replace with your own.
PAYWAY_MODE=mock
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
PAYWAY_MERCHANT_ID=ec474150
PAYWAY_API_KEY=REPLACE_WITH_YOUR_40_CHAR_PUBLIC_KEY
PAYWAY_RSA_PUBLIC_KEY_FILE=keys/payway-public.pem
PAYWAY_RSA_PRIVATE_KEY_FILE=keys/payway-private.pem

# ── Bakong (NBC) Open API ───────────────────────────────────
# BAKONG_MODE=live requires a real developer token (BAKONG_TOKEN).
# NEVER commit the real token. Use mock mode for local testing.
BAKONG_MODE=mock
BAKONG_TOKEN=REPLACE_WITH_YOUR_BAKONG_TOKEN
BAKONG_PROD_BASE=https://api-bakong.nbc.gov.kh
BAKONG_EMAIL=

# ── Server ──────────────────────────────────────────────────
PORT=5200
